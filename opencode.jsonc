{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orquestador",
  "agent": {
    "orquestador": {
      "description": "Agente orquestador que recibe tareas de programación, lógica, algoritmos y estructuras de datos. Analiza la tarea, la descompone y delega a los subagentes especializados adecuados.",
      "mode": "primary",
      "model": "opencode/mimo-v2.6-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "analista": {
      "description": "Agente analista que examina problemas, identifica puntos débiles en soluciones propuestas, define etapas de ejecución y verifica que la ruta se mantenga correcta tras cada etapa. Solo tiene permisos de lectura.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "arquitecto": {
      "description": "Agente arquitecto que diseña la solución de software: estructura del proyecto, elección de herramientas, data structures y algoritmos. Siempre presenta alternativas comparadas.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "desarrollador-java": {
      "description": "Desarrollador Java especializado en OOP. Implementa diseños, crea archivos .java y verifica compilación. No hace testing.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "documentador": {
      "description": "Agente documentador que genera documentación concisa del proyecto: requerimientos, diseño y documentación del código. Trabaja por proyecto y actualiza sesiones.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "permission": {
        "edit": "allow",
        "bash": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  }
}
